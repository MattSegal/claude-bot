# Slack Bot Token (OAuth & Permissions → Bot User OAuth Token), starts with xoxb-
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack App Token (Basic Info → App-Level Tokens, scope connections:write), starts with xapp-
SLACK_APP_TOKEN=xapp-your-app-token

# Slack user IDs allowed to talk to the bot, comma separated (Profile → ... → Copy member ID)
ALLOWED_USER_IDS=U0123456789,U0987654321

# Repo checkouts that conversations lease, colon separated. Each should be its own dev-env slot.
WORKSPACES=~/code/my-repo:~/code/my-repo-1

# Optional
# STATE_DIR=~/.claude-bot            # sqlite state, output files and logs
# CLAUDE_BIN=claude
# DEFAULT_BRANCH=main
# LEASE_TTL_MINUTES=30               # idle time before a thread's checkout is given back
# TURN_TIMEOUT_MINUTES=30            # longest a single Claude turn may run
# WORKSPACE_WAIT_MINUTES=30          # longest a thread waits for a free checkout
# LOG_LEVEL=INFO                     # DEBUG shows every Slack envelope, including disconnect reasons
